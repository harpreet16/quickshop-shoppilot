# Default: Gemini with native Google Search through OpenRouter.
OPENROUTER_API_KEY=
WEBSEARCH_PROVIDER=openrouter
WEBSEARCH_MODEL=google/gemini-3.8-flash

# Direct Google alternative:
# GEMINI_API_KEY=
# WEBSEARCH_PROVIDER=gemini
# WEBSEARCH_MODEL=gemini-3.8-flash

# Direct OpenAI alternative:
# WEBSEARCH_API_KEY=
# WEBSEARCH_PROVIDER=openai
# WEBSEARCH_MODEL=gpt-4o
