API_KEY=


# Firecrawl (web search and product-page reading). Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# B2: Gemini + native web grounding through OpenRouter (no Google API key needed).
OPENROUTER_API_KEY=
WEBSEARCH_PROVIDER=openrouter
WEBSEARCH_MODEL=google/gemini-3.8-flash

# Optional direct Google key (QuickShop model or B2 with WEBSEARCH_PROVIDER=gemini).
GEMINI_API_KEY=

# Optional: where the product-evidence cache is stored (default: .cache/evidence.sqlite3)
QUICKSHOP_EVIDENCE_CACHE=

# Optional: set to 1 to serve evidence only from the cache and never call Firecrawl (reproducible evaluation)
QUICKSHOP_EVIDENCE_REPLAY=

# Optional: where saved search results are stored (default: .cache/search_snapshot.json)
QUICKSHOP_SEARCH_SNAPSHOT=

# Optional: set to 1 to use only saved searches and never call Firecrawl search.
# The --frozen flag turns this on, along with QUICKSHOP_EVIDENCE_REPLAY.
QUICKSHOP_SEARCH_REPLAY=
